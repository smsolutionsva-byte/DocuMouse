# Where the Next.js server proxies /api/* requests (the FastAPI backend).
# The browser never talks to the backend directly.
DOCUMOUSE_API_URL=http://localhost:8000

# --- Authentication (optional) ------------------------------------------------
# Must match the backend's DOCUMOUSE_AUTH_TOKEN. When set, Next.js middleware
# gates every page behind a login screen; the browser sends the token on each
# API call. Leave empty for wide-open local development.
# DOCUMOUSE_AUTH_TOKEN=

# --- Large file uploads (optional) --------------------------------------------
# Vercel's proxy has a ~4.5 MB body limit. If uploads fail, set this to the
# backend's public URL so the browser uploads directly (bypassing the proxy).
# NEXT_PUBLIC_DOCUMOUSE_UPLOAD_URL=https://<your-space>.hf.space/api/documents
