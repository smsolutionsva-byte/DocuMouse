# Hostname only, without https:// or a path. Its DNS must resolve to your server.
# A temporary free example is documouse.SERVER_PUBLIC_IP.sslip.io.
DOCUMOUSE_HOST=mouse.example.com

# Generate each value separately: openssl rand -hex 32
# The database password must be URL-safe; hex avoids connection URL escaping.
DOCUMOUSE_DB_PASSWORD=
DOCUMOUSE_AUTH_TOKEN=
