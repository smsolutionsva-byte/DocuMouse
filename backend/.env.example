# Copy to backend/.env and adjust. Every setting is optional except the database.

# --- Database (PostgreSQL) -------------------------------------------------
DOCUMOUSE_DATABASE_URL=postgresql+psycopg://documouse:documouse@localhost:5432/documouse

# --- Files -------------------------------------------------------------------
# Originals, page images and engine output are stored here (local disk).
DOCUMOUSE_STORAGE_DIR=./data
DOCUMOUSE_MAX_UPLOAD_MB=25
DOCUMOUSE_MAX_PAGES=20
DOCUMOUSE_PDF_RENDER_DPI=200

# --- Document engine (PaddleOCR / PP-StructureV3) -----------------------------
DOCUMOUSE_ENGINE=paddle
# fast = PP-OCRv5 mobile text models (good on CPU); accurate = PP-StructureV3 defaults (server models)
DOCUMOUSE_OCR_PRESET=fast
# Used by the "accurate" preset to pick recognition models (e.g. en, ch, fr, de, ...)
DOCUMOUSE_OCR_LANG=en
# cpu, gpu:0, ... (leave empty to let Paddle decide)
DOCUMOUSE_OCR_DEVICE=
DOCUMOUSE_OCR_DETECT_ORIENTATION=true
# oneDNN CPU acceleration. Leave unset. Only set to false if you run PaddlePaddle 3.3.x on CPU (see README).
# DOCUMOUSE_OCR_ENABLE_MKLDNN=false
DOCUMOUSE_PROCESSING_WORKERS=1
# Where PaddleOCR downloads models from on first run: huggingface (default), modelscope, aistudio, bos
# PADDLE_PDX_MODEL_SOURCE=huggingface
# Once models are downloaded, skip PaddleX's connectivity check on startup:
# PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# --- LLM (optional) ------------------------------------------------------------
# none | groq | openrouter | ollama | lmstudio | openai_compatible
# Without an LLM, DocuMouse uses its deterministic extractor and simple edit commands.
DOCUMOUSE_LLM_PROVIDER=none
DOCUMOUSE_LLM_MODEL=
# Required for groq/openrouter; never exposed to the browser.
DOCUMOUSE_LLM_API_KEY=
# Only needed for openai_compatible, or to override a preset's URL.
DOCUMOUSE_LLM_BASE_URL=
DOCUMOUSE_LLM_TIMEOUT_SECONDS=60

# --- Second reader (optional cross-check) ---------------------------------------
# Reads the first and last page again and compares business name, date and total with what
# PaddleOCR found. Agreement confirms a value; disagreement flags it. It never changes a value.
# none | paddleocr_vl | vision
DOCUMOUSE_SECOND_READER=none
# paddleocr_vl: llama.cpp's llama-server (started with --special) or vLLM serving PaddleOCR-VL,
#   e.g. http://localhost:8080/v1, or PaddleOCR's hosted API (URL ends in /layout-parsing) + token.
DOCUMOUSE_PADDLEOCR_VL_URL=
DOCUMOUSE_PADDLEOCR_VL_TOKEN=
# vision: gemini | openrouter | github | ollama | lmstudio | openai_compatible
# Free tiers may use what you send to improve the provider's models. Check before sending clients' documents.
DOCUMOUSE_VISION_PROVIDER=gemini
DOCUMOUSE_VISION_API_KEY=
# Defaults to gemini-3.8-flash for gemini; required for the other providers.
DOCUMOUSE_VISION_MODEL=
# Only needed for openai_compatible, or to override a provider's URL.
DOCUMOUSE_VISION_BASE_URL=
DOCUMOUSE_SECOND_READER_TIMEOUT_SECONDS=180

# --- HTTP ----------------------------------------------------------------------
# JSON list. Only needed if the browser calls the API directly (the Next.js proxy doesn't need it).
DOCUMOUSE_CORS_ORIGINS=["http://localhost:3000"]
